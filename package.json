{
  "name": "spqr",
  "version": "0.0.0",
  "private": true,
  "description": "SPQR — Hannibal ad Portas. A browser RTS in the Second Punic War, rendered from code.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run guard && tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b",
    "lint": "eslint .",
    "guard": "node scripts/guard.mjs",
    "match": "node src/cli/main.ts",
    "agent": "node src/cli/agent-main.ts",
    "replay": "node src/cli/replay-main.ts",
    "bake": "node src/cli/bake-main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "playwright install chromium",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run check && npm run guard && npm run test && npm run build"
  },
  "dependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
